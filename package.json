{
  "name": "adi-ht9046-predictive-maintenance",
  "version": "2.0.0",
  "description": "FastAPI + WebSocket dashboard with read-only MySQL telemetry for Vacuum Pump and Compressor modules",
  "main": "app/main.py",
  "scripts": {
    "start": "python -m uvicorn app.main:app --host 0.0.0.0 --port 5001",
    "dev": "python -m uvicorn app.main:app --host 0.0.0.0 --port 5001 --reload",
    "frontend:dev": "vite --host 0.0.0.0 --port 5173 --config frontend/vite.config.js",
    "frontend:build": "vite build --config frontend/vite.config.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "echarts": "^5.5.1",
    "lucide-react": "^0.468.0",
    "vite": "^6.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
